description = "第七车：旧教堂送药人一名，随身药箱一只。\n已转入内院，原名另册保管。\n\n下面几页只剩药材编号。页边盖着血蔷薇印，印章下写着：转运门须在两侧水闸开启后通行。"

[node name="HiddenLetter" type="Marker2D" parent="Gameplay"]
position = Vector2(720, 144)
script = ExtResource("4")
kind = 1
action_id = "HiddenLetter"
required = false
title = "没有寄出的信"
description = "姐姐：\n我把你的名字又写了一遍，藏在最上面的书架上。她们收走了名册，我怕再过几天，连我也只会叫你的编号。\n\n拾到这封信的人：请把它送到旧教堂。信封里的药签，是我姐姐留下的。"

